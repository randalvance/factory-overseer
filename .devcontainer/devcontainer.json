{
  "name": "factory-overseer",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/shyim/devcontainers-features/bun:0": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12", "installTools": false },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "demo", "onAutoForward": "notify" }
  },
  "appPort": [3000],
  "initializeCommand": [
    "node",
    "-e",
    "const fs = require('node:fs'), os = require('node:os'), path = require('node:path'); for (const dir of new Set([process.env.HOME, os.homedir()].filter(Boolean))) fs.closeSync(fs.openSync(path.join(dir, '.gitconfig'), 'a'))"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/node/.host-gitconfig,type=bind,readonly"
  ],
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["vitest.explorer"]
    }
  }
}
